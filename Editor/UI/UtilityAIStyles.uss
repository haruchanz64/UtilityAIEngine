.uai-root {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
    min-height: 0;
    background-color: var(--unity-colors-window-background);
    color: var(--unity-colors-window-text);
}

.uai-header {
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    padding: 8px 12px;
    background-color: var(--unity-colors-app_toolbar-background);
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-window-border);
}

.uai-header-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: var(--unity-colors-window-text);
}

.uai-header-subtitle {
    font-size: 11px;
    color: var(--unity-colors-default-text);
    opacity: 0.72;
}

.uai-body {
    flex-grow: 1;
    flex-direction: row;
    min-width: 0;
    min-height: 0;
}

.uai-sidebar {
    width: 190px;
    min-width: 165px;
    flex-shrink: 0;
    padding: 8px;
    background-color: var(--unity-colors-box-background);
    border-right-width: 1px;
    border-right-color: var(--unity-colors-default-border);
}

.uai-nav-button {
    height: 30px;
    margin-bottom: 4px;
    -unity-text-align: middle-left;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 4px;
}

.uai-nav-button--active {
    background-color: var(--unity-colors-highlight-background);
    border-left-width: 3px;
    border-left-color: var(--unity-colors-link-text);
    color: #ffffff;
    -unity-font-style: bold;
}

.uai-root--narrow .uai-body {
    flex-direction: column;
}

.uai-root--narrow .uai-sidebar {
    width: auto;
    min-width: 0;
    flex-direction: row;
    flex-wrap: wrap;
    border-right-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-default-border);
}

.uai-root--narrow .uai-nav-button {
    height: 26px;
    margin-right: 4px;
}

.uai-content {
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
    padding: 10px 14px;
}

.uai-card {
    background-color: var(--unity-colors-helpbox-background);
    border-width: 1px;
    border-color: var(--unity-colors-helpbox-border);
    border-radius: 6px;
    padding: 10px;
    margin-bottom: 10px;
    min-width: 0;
}

.uai-section-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: var(--unity-colors-window-text);
    margin-bottom: 6px;
}

.uai-muted-label {
    font-size: 11px;
    color: var(--unity-colors-default-text);
    opacity: 0.72;
    white-space: normal;
}

.uai-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    margin-bottom: 6px;
}

.uai-split {
    flex-direction: row;
    flex-grow: 1;
    min-width: 0;
    min-height: 0;
}

.uai-pane-left {
    width: 280px;
    min-width: 220px;
    flex-shrink: 0;
    margin-right: 10px;
}

.uai-pane-right {
    flex-grow: 1;
    min-width: 0;
}

.uai-curve-container {
    background-color: rgba(0, 0, 0, 0.22);
    border-width: 1px;
    border-color: var(--unity-colors-default-border);
    border-radius: 5px;
    padding: 6px;
    margin-top: 6px;
    margin-bottom: 6px;
}

.uai-curve-canvas {
    width: 100%;
    min-height: 150px;
}

.uai-curve-caption {
    font-size: 11px;
    opacity: 0.85;
    margin-top: 4px;
    -unity-text-align: middle-center;
}

.uai-score-row {
    flex-direction: column;
    padding: 6px 8px;
    margin-bottom: 6px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.14);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
}

.uai-score-row--winner {
    border-color: rgb(66, 198, 128);
    background-color: rgba(66, 198, 128, 0.12);
}

.uai-score-row--blocked {
    opacity: 0.62;
}

.uai-score-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.uai-score-title {
    font-size: 12px;
    -unity-font-style: bold;
}

.uai-score-value {
    font-size: 11px;
    -unity-font-style: bold;
}

.uai-bar-track {
    height: 10px;
    width: 100%;
    background-color: rgba(0, 0, 0, 0.35);
    border-radius: 4px;
    overflow: hidden;
    margin-bottom: 4px;
}

.uai-bar-fill {
    height: 100%;
    background-color: rgb(74, 158, 255);
    border-radius: 4px;
}

.uai-bar-fill--winner {
    background-color: rgb(66, 198, 128);
}

.uai-bar-fill--blocked {
    background-color: rgb(185, 86, 86);
}

.uai-consideration-line {
    font-size: 11px;
    opacity: 0.85;
    padding-left: 8px;
    margin-top: 2px;
}

.uai-badge {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 3px;
    margin-left: 6px;
    background-color: rgba(74, 158, 255, 0.25);
}

.uai-badge--winner {
    background-color: rgba(66, 198, 128, 0.32);
}

.uai-badge--warn {
    background-color: rgba(235, 130, 65, 0.32);
}

.uai-history-item {
    flex-direction: row;
    justify-content: space-between;
    padding: 4px 6px;
    margin-bottom: 2px;
    border-radius: 3px;
    background-color: rgba(0, 0, 0, 0.12);
}

.uai-history-item--selected {
    background-color: var(--unity-colors-highlight-background);
}
